PORT=5000

# Local MongoDB (default if you run `mongod` on your machine):
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_management

# If you use MongoDB Atlas instead, replace MONGODB_URI with your
# connection string, e.g.:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hospital_management

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10